{
  "name": "pj",
  "version": "1.0.0",
  "description": "CLI SVG editor for the software design course",
  "main": "dist/main.js",
  "exports": {
    "./plugin-api": {
      "types": "./dist/plugin-api/index.d.ts",
      "default": "./dist/plugin-api/index.js"
    }
  },
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "build:plugins": "tsc -p tsconfig.plugin-api.json && npm --prefix plugins/plugin-stats run build",
    "check": "npm run build:plugins && tsc --noEmit",
    "build": "npm run build:plugins && tsc --declaration false",
    "cli": "npm run build && node dist/main.js",
    "test": "npm run build && node --test tests/*.test.cjs plugins/plugin-stats/tests/*.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
