// 用途：先构建扩展，再以 fixtures 为工作区启动 Extension Development Host。
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SVG Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/fixtures"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build SVG extension"
    }
  ]
}
